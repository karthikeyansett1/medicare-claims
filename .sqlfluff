[sqlfluff]
dialect = postgres
templater = dbt
encoding = utf-8
max_line_length = 120
# Enforce readable layout, explicit aliases, and safe comparisons without
# rewriting intentional SELECT * passthroughs or Jinja-generated projections.
rules = layout,capitalisation,aliasing.table,aliasing.column,convention.not_equal,convention.is_null

[sqlfluff:templater:dbt]
project_dir = dbt_project
profiles_dir = dbt_project
profile = medicare
target = dev
dbt_skip_compilation_error = False

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower
