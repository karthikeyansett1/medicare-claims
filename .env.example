PG_HOST=localhost
PG_PORT=5432
PG_USER=medicare
PG_PASSWORD=replace-with-a-local-password
PG_DB=medicare
ASSISTANT_PG_PASSWORD=
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-6-astra
DATA_DIR=data/extracted

# Persistent server-wide limits; failed calls consume reservations.
ASSISTANT_CALLS_PER_MINUTE=6
ASSISTANT_CALLS_PER_DAY=60
ASSISTANT_TOKEN_BUDGET_PER_DAY=1000000

# Owner-only opt-in; leave false until funded live validation is authorized.
ENABLE_LIVE_ASSISTANT=false
# Optional remote read-only DSN, never an administrator connection.
ASSISTANT_DATABASE_URL=
# Deployment scripts only; never ship either value to the static Space.
DEPLOY_DATABASE_URL=
DEPLOY_ASSISTANT_DATABASE_URL=
